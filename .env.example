# Postgres for the waitlist. Without it /api/waitlist returns 500 by design --
# a landing page that silently drops signups is worse than one that admits it.
DATABASE_URL=

# ---------------------------------------------------------------------------
# NOT YET USED. Added when the dapp lands, and worth reading before it does.
#
# A browser dapp has to reach an RPC directly, so the endpoint must be inlined
# into the client bundle -- which means NEXT_PUBLIC_ and which means PUBLISHED.
# Anyone can open devtools and read it. That is not a leak to be fixed, it is
# how a client-side dapp works.
#
# So the key is not a secret and must not be treated as one:
#   - use a SEPARATE Alchemy app for this domain, never a shared key
#   - restrict it in Alchemy to the strk20.atrum.fun referrer
#   - keep a rate cap on it, and expect it to be used by strangers
#
# Anything that must actually stay private goes in a server-only variable with
# NO NEXT_PUBLIC_ prefix and is read inside a route handler.
# NEXT_PUBLIC_STARKNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/<key>

# Set to 1 to enable the market UI at /app. Unset in production until the wallet
# flow has been tested against a real wallet.
NEXT_PUBLIC_ENABLE_APP=
